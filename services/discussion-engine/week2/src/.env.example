LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gemma4:31b
API_KEY=
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ── Retrieval (Week 1 RAG service) ───────────────────────────
RETRIEVAL_API_BASE_URL=http://localhost:8000
RETRIEVAL_TOP_K=5

# ── Query expansion loop ─────────────────────────────────────
# Number of LLM-driven query rewrites per source before escalating.
# Total retrievals per source = 1 (initial) + QUERY_EXPANSION_ATTEMPTS.
# Set to 0 to disable expansion and fall back to the legacy single-shot behavior.
QUERY_EXPANSION_ATTEMPTS=3
# Comma-separated escalation order. The loop walks this list and only
# stops once a source returns chunks that the relevance grader accepts.
# Recognized values: "rag", "web".
CONTEXT_SOURCES_ORDER=rag,web
# Maximum number of independent research queries resolved concurrently.
EVIDENCE_POOL_MAX_WORKERS=3
# Shared cap for relevance-grading and query-expansion calls in one run.
RESEARCH_MAX_MODEL_CALLS=16

# ── Session memory (Cross-Run Memory) ───────────────────────────────
# Master switch for the rolling-summary cross-run memory.
MEMORY_ENABLED=true
# Max execution turns kept in RAM before older ones are compacted into the rolling summary.
MEMORY_WINDOW_SIZE=4
# Soft token budget safety net; compaction fires when the working buffer exceeds this.
MEMORY_TOKEN_BUDGET=2000
