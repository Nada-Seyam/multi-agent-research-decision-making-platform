DB_HOST=your_supabase_pooler_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_supabase_project_ref
DB_PASSWORD=your_supabase_password
DB_SSLMODE=require
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
MODEL_NAME=BAAI/bge-m3
# `auto` uses CUDA when available and otherwise falls back to CPU.
RETRIEVAL_DEVICE=auto
# Optional PyTorch CPU thread override; the service default is capped at 8.
TORCH_THREADS=8
# ── Retrieval pipeline ─────────────────────────────────────────
# Master switch. When false, /search is the original dense-only endpoint
# with no post-filters and no rerank.
RETRIEVAL_ENABLED=true
# Candidate pool size from dense retrieval (BGE-M3).
RETRIEVAL_DENSE_TOP_N=50
# Optional BM25 lexical retrieval. Requires `pip install rank-bm25`.
RETRIEVAL_USE_BM25=true
RETRIEVAL_BM25_TOP_N=50

# Reciprocal Rank Fusion smoothing constant (Cormack 2009 standard = 60).
RETRIEVAL_RRF_K=60
# Post-fusion filters applied BEFORE the reranker.
RETRIEVAL_DEDUP_ON_TEXT=true
RETRIEVAL_MAX_PER_DOCUMENT=2
RETRIEVAL_MIN_SIMILARITY=0.0

# Optional reranker. Off by default; flip on for D/F runs.
RETRIEVAL_USE_RERANKER=true
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANKER_TOP_N=30
